# Relay — environment template
#
# Copy to .env for local development:   cp .env.example .env
# .env itself is gitignored and must never be committed.
#
# Only the two VITE_ variables below are needed to build and run the app.
# Everything under "Deployment only" is used by the Foundry and Circle deploy
# scripts, never by the frontend, and must not be set in a hosting provider.

# ── Frontend (public, bundled into the build) ────────────────────────────────
# These end up in the shipped JavaScript. A contract address and a chain id are
# public information, so that is fine. Never put a secret behind a VITE_ prefix.

# Deployed USDCSplitPay address. Empty string = not deployed, which disables all
# payment actions in the UI.
VITE_SPLIT_PAY_ADDRESS=

# testnet = Arc Testnet (chain 5042002)  |  mainnet = Arc (chain 5042)
VITE_NETWORK=testnet


# ── Deployment only (secrets — never commit, never set on Vercel) ────────────
# Leave these unset unless you are running a deploy script locally.

# Deployer key for: forge script contracts/script/DeployUSDCSplitPay.s.sol
# PRIVATE_KEY=

# Deployer key for: bun run compass:deploy --signer private-key
# DEPLOYER_PRIVATE_KEY=

# Override the USDC token address. Defaults to 0x3600000000000000000000000000000000000000,
# which is correct on both Arc Testnet and Arc Mainnet.
# USDC_ADDRESS=

# CREATE2 deployment (scripts/DeployCreate2.s.sol)
# FACTORY_ADDRESS=
# CREATE2_SALT_STRING=
# CREATION_CODE=
# DEPLOY_VALUE=

# Circle RPC proxy, used by scripts/compass-deploy-helpers.ts
# RPC_PROXY_BASE_URL=
# RPC_PROXY_TOKEN=
# RPC_PROXY_CHAINS=
